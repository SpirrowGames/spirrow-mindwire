{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git branch -D:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm -rf:*)",
      "Bash(Remove-Item -Recurse:*)"
    ]
  }
}
