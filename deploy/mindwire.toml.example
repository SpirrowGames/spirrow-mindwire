# deploy/mindwire.toml.example — Stage 3 conductor daemon config template (ADR-18).
#
# Copy to <data_dir>/config/mindwire.toml (default <data_dir> = ~/spirrow-mindwire-data, or set
# MINDWIRE_PATHS__DATA_DIR) and fill in [conductor].task_thread_id + [loop].repo_dir for your run.
#
# Secrets and inference endpoints stay OUT of this file — they are resolved from the environment by
# the adapters at spawn (see deploy/run-conductor.ps1): MINDWIRE_IMPLEMENTER_BASE_URL,
# MINDWIRE_NAYSAYER_BASE_URL, MINDWIRE_LEXORA_URL, MINDWIRE_NAYSAYER_GITHUB_TOKEN,
# MINDWIRE_MAGICKIT_MCP_URL (the last defaults to the in-code Tailscale endpoint).
#
# The T-decision-request-composer S2 wiring reads three env vars, all optional (in-code defaults
# apply otherwise, and the deploy still works with none of them set):
#   MINDWIRE_DECISION_COMPOSER_BACKEND  = 'stub' (default) | 'claude-code' (added in S3)
#   MINDWIRE_DECISION_COMPOSER_IDENTITY = 'Composer' (default; MUST NOT be Bohr / Heisenberg /
#                                          Einstein — the I-5 role-independence rule)
#   MINDWIRE_DECISION_DASHBOARD_URL     = base URL of the Magickit dashboard used in the Discord
#                                          alert's D-29 link. Default:
#                                          https://sg-ai-server-01.taile861db.ts.net:8443

schema_version = 1

[loop]
# The magickit chatroom project the conductor drives.
project = "spirrow-voxelworld"
# The implementer's own clone of the target repo (NOT a linked worktree — a worktree anchors
# Claude Code's project-root to the main repo, so fs.write lands outside repo_root and is denied).
repo_dir = "C:/workspace/sandbox/voxelworld-impl"

[conductor]
# The single design thread the conductor drives (1 task = 1 thread). REQUIRED.
task_thread_id = "T-REPLACE-WITH-DESIGN-THREAD"
# The roster persona that fills the independent naysayer slot; MUST map to "naysayer" in [roster].
naysayer_identity = "Einstein"
# The persona whose authored Tier-C decide may direct the implementer (design→implement carve-out).
# 運用規約: post Tier-C GOs under EXACTLY this identity (a relay name like "Bohr" will not fire the
# carve-out — the flag-1 gap). Empty string disables the carve-out (fail-safe). Default "human".
human_identity = "human"
# Runaway backstop: max serial turns before the conductor stops (default 40).
max_rounds = 40
# Cost lever (default false). When true, the conductor forces an Obj2 naysayer consult ONLY on an
# explicit `NEXT: human` (the genuine Tier-C handoff) — not on a guard-(i) design->implement redirect
# or an ABSENT / Q-A un-routed turn, which then fall straight through to the human. Trims redundant
# design-loop naysayer (Gemini) calls; the per-segment single-consult bound is unchanged.
force_naysayer_only_on_explicit_human = false

# Chatroom identity -> role map. The NEXT: vocabulary is the persona name; the conductor authors
# each reply under that name. Reserved words `human` / `none` are NOT roster entries.
[conductor.roster]
Bohr = "proposer"
Heisenberg = "implementer"
Einstein = "naysayer"

# PR-review debounce knobs (cost levers, all default-off). They trim redundant Tier B re-reviews —
# a PR averaged ~2.4 naysayer reviews (max 13) because each implementer fix push re-fired a full
# Gemini review. Leave unset/false to keep the prior behavior (a full review on every fire).
[naysayer_gating]
# Skip the (costly) Gemini review and reuse the prior verdict when the naysayer has already reviewed
# THIS exact head SHA (its last verdict review's commit_id == the PR head) — catches accidental /
# reflexive re-fires on an unchanged commit.
skip_if_head_unchanged = false
# Cap on naysayer reviews per PR before escalating to the human (0 = disabled). At the cap the gate
# short-circuits to a COMMENT (which routes the conductor to the human Tier-C, not back into the
# implementer fix loop) instead of spending another Gemini review. Bounds the long re-review tail.
max_review_rounds = 0
# The GitHub login the naysayer submits reviews under (T22). The debounce counts only reviews by this
# login, so other reviewers (Copilot, the author) are not mistaken for the naysayer's own.
review_login = "spirrowgames-ops"
# Shadow (observe-only) mode: compute + LOG the skip/cap decisions but DON'T act on them (the full
# Gemini review still runs, so behaviour/coverage are unchanged). Set it together with
# skip_if_head_unchanged / max_review_rounds to size the saving risk-free before enforcing.
# (The conductor's forced-consult saving is always logged as forced_naysayer_saveable — no flag.)
shadow = false
