#!/usr/bin/env bash
# Single source of truth for the spirrow-mindwire gate.
# Run identically by CI (.github/workflows/ci.yml) and the autonomous loop's
# implementer (it executes `bash .mindwire-gate`), so the two can never drift.
# Exit 0 = green.
set -euo pipefail
uv run ruff check .
uv run ruff format --check .
uv run mypy src tests
# The sweep wrapper is PowerShell, so pytest cannot reach its head-skip decision — the one place
# where being wrong parks the loop silently instead of loudly. pwsh ships on the CI runner and on
# the loop host; a missing pwsh is a real breakage of this gate, not a reason to skip the check.
pwsh -NoProfile -File tests/Test-SweepHeadCache.ps1
uv run pytest
